PORT=5000
NODE_ENV=production
API_PUBLIC_BASE_URL=http://localhost:5000

# Browser origins allowed to call this API. Use comma-separated origins in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage access - backend only
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_ANON_KEY=replace_with_anon_key_if_user_scoped_clients_are_needed
SUPABASE_STORAGE_BUCKET=documents

# Gemini API - backend only
GEMINI_API_KEY=replace_with_gemini_api_key

# BYOK (Bring Your Own Key) encryption — AES-256-GCM
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes). Keep this secret!
ENCRYPTION_SECRET=replace_with_64_char_hex_secret
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash,gemini-3.5-flash
GEMINI_RPM_LIMIT=5
GEMINI_TPM_LIMIT=250000
GEMINI_RPD_LIMIT=20
AI_DAILY_USER_REQUEST_LIMIT=10
GEMINI_TIMEOUT_MS=90000

# External Ollama. In Docker, do not use localhost unless Ollama is in the same container/network.
OLLAMA_BASE_URL=https://your-secure-ollama-tunnel.example.com
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_ALLOWED_MODELS=qwen2.5:3b
OLLAMA_CHAT_TIMEOUT_MS=180000

# Embeddings for semantic RAG retrieval
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_MS=90000

# Best-effort persisted document overviews generated after chunking
DOCUMENT_OVERVIEW_ENABLED=true
DOCUMENT_OVERVIEW_PROVIDER=ollama
DOCUMENT_OVERVIEW_MODEL=qwen2.5:3b
DOCUMENT_OVERVIEW_MAX_CHARS=12000
DOCUMENT_OVERVIEW_MAX_CHUNKS=8

# OCR and document rendering tools
TESSERACT_PATH=tesseract
MUTOOL_PATH=mutool
PDFTOPPM_PATH=pdftoppm
LIBREOFFICE_PATH=soffice
OCR_LANG=eng+vie
OCR_ENABLED=true
OCR_TIMEOUT_MS=30000
OCR_MAX_PDF_PAGES=10
OCR_MAX_IMAGE_BYTES=15728640
OCR_MAX_CONCURRENT_JOBS=1

# Background cleanup. Disable on Render web services and run the lifecycle CLI from a Cron Job.
IN_PROCESS_CLEANUP_ENABLED=true
SESSION_LIFECYCLE_CRON=17 * * * *

# Immutable shared chat snapshots remain off until migration 022 and verification complete.
CHAT_SNAPSHOT_SHARING_ENABLED=false

# Lightweight post-retrieval factual verification layer (runs between RAG retrieval and LLM generation)
# Uses local Ollama only — zero API cost, zero quota usage.
# Set to false to disable entirely with zero overhead.
VERIFICATION_ENABLED=true
# Maximum ms to wait for the local Ollama verifier before falling back to 'uncertain'.
VERIFY_TIMEOUT_MS=3000
# Set to true to log gate decisions and LLM responses in non-production environments.
VERIFY_DEBUG=false
