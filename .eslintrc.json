{
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": ["frontend/**/*.{js,jsx}"],
      "env": {
        "browser": true,
        "node": false
      }
    },
    {
      "files": ["backend/**/*.js"],
      "env": {
        "browser": false,
        "node": true
      }
    }
  ]
}
